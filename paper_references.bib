,@ARTICLE{Wei2017-us,
  title     = "Greener urbanization? Changing accessibility to parks in China",
  author    = "Wei, Fang",
  journal   = "Landsc. Urban Plan.",
  publisher = "Elsevier BV",
  volume    =  157,
  pages     = "542--552",
  abstract  = "As important city and community assets, parks provide ideal open
               spaces for public recreation, outdoor activities, and residents’
               socialization. Using the Gaussian-based 2SFCA method, this study
               evaluates park accessibility by two thresholds across the 41
               sub-districts in Hangzhou and highlights the issue of the
               changing accessibility of parks over the past decade. The results
